{
  "expo": {
    "name": "Perkly",
    "slug": "perkly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perkly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.perkly.student",
      "infoPlist": {
        "NSCameraUsageDescription": "Perkly uses your camera to scan the merchant's QR code.",
        "NSLocationWhenInUseUsageDescription": "Perkly uses your location to show nearby perks and confirm you're in-store when you redeem."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B2FF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.perkly.student"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7B2FF7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Perkly uses your camera to scan the merchant's QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Perkly uses your location to show nearby perks and confirm you're in-store when you redeem."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
